# Standalone engine + model auto-download on first run - never commit binaries.
app/bin/
app/bin-cuda/
app/models/
app/data/
app/sessions/
# same dirs when running ezcodex.exe from repo root (frozen layout, root-only)
/bin/
/bin-cuda/
/models/
/data/
/sessions/
ezcodex.bat
xcoder.bat
ezcodex.exe
*.exe
*.gguf
# Generated merge outputs (regenerate via datasets/scripts/merge.py) - source of
# truth is datasets/<stack>.jsonl, never edit finetune data directly.
finetune/stacks/*/dataset.jsonl
finetune/stacks/*/eval.jsonl
datasets/all.jsonl
# Audit report + review samples (generated by datasets/scripts/audit.py)
datasets/audit/
# Bulk import raw cache + provenance ledger (regenerable / too large for git)
datasets/raw/
datasets/manifests/ledger.jsonl
# Audit quarantine dump (rows flagged by audit.py --fix)
datasets/_quarantine.jsonl
# Staging untuk upload ke Google Drive (drag folder ini ke MyDrive)
drive_upload/
# Staging untuk upload ke Kaggle Datasets (xcoder-mt, xcoder-training)
kaggle_upload/
# MT run state (lock + log + cache boleh sambung)
datasets/.fable_mt.lock
datasets/.fable_mt_run.log
datasets/.fable_mt_run.err.log
datasets/.fable_mt_cache.jsonl
datasets/.fable_mt_cache.bak.jsonl
# Local training run state (lock + log) + venv convert GGUF
finetune/.train_run.lock
finetune/.train_run.log
.venv-gguf/
finetune/linuxdocker/
finetune/runs/
finetune/masters/
__pycache__/
*.pyc
build/
dist/
*.spec

# Training datasets are kept out of this repo (stored separately)
/datasets/
